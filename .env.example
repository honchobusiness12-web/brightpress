# Database
DATABASE_URL=postgresql://user:password@localhost:5432/brightpress

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Auth
AUTH_SECRET=your-random-secret-key-at-least-32-chars

# URLs
NEXTAUTH_URL=https://brightpress.click
NEXT_PUBLIC_APP_URL=https://brightpress.click

# Environment
NODE_ENV=production

