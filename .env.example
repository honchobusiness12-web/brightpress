# PostgreSQL connection string provided by Railway
DATABASE_URL=postgresql://user:password@host:5432/railway

# Google Cloud OAuth 2.0 credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=YOUR_RANDOM_SECRET_KEY

# Production domain (used to build OAuth redirect URIs)
NEXTAUTH_URL=https://your-domain.com

# Publicly reachable app URL (used client-side and for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# production or development
NODE_ENV=development
